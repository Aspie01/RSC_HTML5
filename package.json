{
  "name": "thalren-vale",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An isometric, tick-based RPG inspired by RuneScape Classic and OSRS.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/inline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && node tools/pack.mjs",
    "serve:game": "node tools/serve.mjs dist 4173",
    "serve:harness": "node tools/serve.mjs tools 4174"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
